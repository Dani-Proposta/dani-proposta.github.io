
---
import { portfolioContact } from "../config/site";

const year = new Date().getFullYear();

/* Identidade e contatos centralizados na configuração */
const siteName = "Dani";
const githubUrl = portfolioContact.github.trim();
const email = portfolioContact.email.trim();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__identity">
      <span class="site-footer__symbol" aria-hidden="true">
        ✦
      </span>

      <p>
        © {year} Portfólio da <strong>{siteName}</strong>.
      </p>
    </div>

    <nav class="site-footer__links" aria-label="Links do rodapé">
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="site-footer__dot" aria-hidden="true"></span>
          GitHub
        </a>
      )}

      {email && (
        <a href={`mailto:${email}`}>
          <span class="site-footer__dot" aria-hidden="true"></span>
          E-mail profissional
        </a>
      )}
    </nav>
  </div>
</footer>

<style>
  /* Estrutura do rodapé */
  .site-footer {
    position: relative;
    margin-top: auto;
    padding-block: 1.5rem;

    border-top: 1px solid rgba(177, 139, 255, 0.22);

    background: linear-gradient(
      180deg,
      rgba(13, 12, 29, 0.72),
      rgba(8, 11, 22, 0.92)
    );
  }

  /* Linha de energia superior */
  .site-footer::before {
    content: "";
    position: absolute;

    top: -1px;
    left: 50%;

    width: min(260px, 45%);
    height: 1px;

    transform: translateX(-50%);

    background: linear-gradient(
      90deg,
      transparent,
      #cba5ff,
      transparent
    );

    box-shadow: 0 0 12px rgba(177, 139, 255, 0.65);

    pointer-events: none;
  }

  /* Conteúdo alinhado ao restante do site */
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  /* Identidade */
  .site-footer__identity {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .site-footer__symbol {
    color: #cba5ff;
    font-size: 1rem;

    text-shadow:
      0 0 10px rgba(177, 139, 255, 0.75);
  }

  .site-footer__identity p {
    margin: 0;

    color: #bcbdd1;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .site-footer__identity strong {
    color: #eee3ff;
    font-weight: 700;
  }

  /* Links tecnológicos */
  .site-footer__links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;

    min-height: 38px;
    padding: 0.55rem 0.9rem;

    border: 1px solid rgba(177, 139, 255, 0.23);
    border-radius: 999px;

    background: rgba(23, 20, 43, 0.55);

    color: #d8c4f7;
    font-size: 0.79rem;
    font-weight: 600;
    text-decoration: none;

    transition:
      transform 220ms ease,
      border-color 220ms ease,
      background 220ms ease,
      box-shadow 220ms ease,
      color 220ms ease;
  }

  /* Pequenos indicadores de energia */
  .site-footer__dot {
    width: 4px;
    height: 4px;

    border-radius: 50%;
    background: #c69fff;

    box-shadow: 0 0 8px rgba(177, 139, 255, 0.85);
  }

  .site-footer__links a:hover {
    transform: translateY(-2px);

    border-color: rgba(213, 176, 255, 0.72);
    background: rgba(59, 34, 97, 0.48);

    color: #fff;

    box-shadow:
      0 0 18px rgba(177, 139, 255, 0.2);
  }

  .site-footer__links a:focus-visible {
    outline: 2px solid #dec6ff;
    outline-offset: 3px;
  }

  /* Layout compacto para celular e tablet estreito */
  @media (max-width: 720px) {
    .site-footer__inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .site-footer__links {
      width: 100%;
      justify-content: center;
    }

    .site-footer__links a {
      min-height: 44px;
    }
  }

  /* Evita aperto dos links em telas muito pequenas */
  @media (max-width: 360px) {
    .site-footer__links {
      gap: 0.5rem;
    }

    .site-footer__links a {
      padding-inline: 0.75rem;
      font-size: 0.75rem;
    }
  }

  /* Acessibilidade */
  @media (prefers-reduced-motion: reduce) {
    .site-footer__links a {
      transition: none;
    }

    .site-footer__links a:hover {
      transform: none;
    }
  }
</style>
