
---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  variant?: "primary" | "secondary" | "warm";
  showArrow?: boolean;
}

const {
  variant = "primary",
  showArrow = true,
  class: customClass,
  target,
  rel,
  ...linkProps
} = Astro.props;

const safeRel =
  target === "_blank"
    ? rel ?? "noopener noreferrer"
    : rel;
---

<a
  {...linkProps}
  target={target}
  rel={safeRel}
  class:list={[
    "cosmic-btn",
    `cosmic-btn--${variant}`,
    customClass
  ]}
>
  <span class="cosmic-btn__content">
    <slot />
  </span>

  {showArrow && (
    <svg
      class="cosmic-btn__arrow"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7" />
      <path d="M8 7h9v9" />
    </svg>
  )}
</a>

<style>
  /* Base do botão */
  .cosmic-btn {
    --btn-rgb: 189, 139, 255;

    position: relative;
    isolation: isolate;
    overflow: hidden;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;

    min-height: 48px;
    padding: 0.85rem 1.35rem;

    border: 1px solid transparent;
    border-radius: 13px;

    color: #faf7ff;
    font: inherit;
    font-size: 0.93rem;
    font-weight: 700;
    line-height: 1.35;
    text-align: center;
    text-decoration: none;

    cursor: pointer;

    background:
      linear-gradient(
        135deg,
        rgba(88, 43, 153, 0.98),
        rgba(41, 23, 84, 0.98)
      ) padding-box,
      linear-gradient(
        120deg,
        #eed5ff,
        #a46ee7 55%,
        #6c459b
      ) border-box;

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 5px 18px rgba(18, 8, 40, 0.35),
      0 0 17px rgba(var(--btn-rgb), 0.22);

    transition:
      transform 260ms ease,
      box-shadow 260ms ease,
      filter 260ms ease;
  }

  /* Conteúdo acima do reflexo */
  .cosmic-btn__content,
  .cosmic-btn__arrow {
    position: relative;
    z-index: 2;
  }

  /* Reflexo que percorre o botão */
  .cosmic-btn::before {
    content: "";

    position: absolute;
    z-index: 1;

    top: -60%;
    left: -85%;

    width: 55%;
    height: 220%;

    transform: rotate(20deg);

    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.18),
      transparent
    );

    pointer-events: none;

    transition:
      left 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Microcanto tecnológico */
  .cosmic-btn::after {
    content: "";

    position: absolute;
    z-index: 2;

    top: 7px;
    right: 7px;

    width: 8px;
    height: 8px;

    border-top: 1px solid rgba(255, 255, 255, 0.48);
    border-right: 1px solid rgba(255, 255, 255, 0.48);

    opacity: 0.75;
    pointer-events: none;
  }

  /* Movimento da seta */
  .cosmic-btn__arrow {
    flex-shrink: 0;

    color: #ead7ff;

    transition:
      transform 260ms ease,
      color 260ms ease;
  }

  /* Variante secundária */
  .cosmic-btn--secondary {
    --btn-rgb: 165, 126, 222;

    background:
      linear-gradient(
        135deg,
        rgba(28, 23, 48, 0.98),
        rgba(17, 16, 35, 0.98)
      ) padding-box,
      linear-gradient(
        120deg,
        #a785d1,
        #554470 65%,
        #7b609d
      ) border-box;

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 0 12px rgba(var(--btn-rgb), 0.12);
  }

  /* Variante de energia quente */
  .cosmic-btn--warm {
    --btn-rgb: 255, 166, 117;

    color: #fff8f2;

    background:
      linear-gradient(
        135deg,
        rgba(125, 68, 43, 0.98),
        rgba(64, 32, 47, 0.98)
      ) padding-box,
      linear-gradient(
        120deg,
        #ffddae,
        #f3a182 55%,
        #9860a3
      ) border-box;

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 0 18px rgba(var(--btn-rgb), 0.2);
  }

  .cosmic-btn--warm .cosmic-btn__arrow {
    color: #ffdbbd;
  }

  /* Estado interativo */
  .cosmic-btn:hover {
    transform: translateY(-3px);

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.19),
      0 10px 25px rgba(12, 5, 29, 0.4),
      0 0 24px rgba(var(--btn-rgb), 0.4),
      0 0 43px rgba(var(--btn-rgb), 0.14);
  }

  .cosmic-btn:hover::before {
    left: 155%;
  }

  .cosmic-btn:hover .cosmic-btn__arrow {
    transform: translate(3px, -3px);
    color: #fff;
  }

  /* Resposta ao clique */
  .cosmic-btn:active {
    transform: translateY(0) scale(0.985);
  }

  /* Navegação por teclado */
  .cosmic-btn:focus-visible {
    outline: 2px solid #f7e5ff;
    outline-offset: 4px;
  }

  /* Usuários que preferem menos movimento */
  @media (prefers-reduced-motion: reduce) {
    .cosmic-btn,
    .cosmic-btn::before,
    .cosmic-btn__arrow {
      transition: none;
    }

    .cosmic-btn:hover,
    .cosmic-btn:active {
      transform: none;
    }

    .cosmic-btn:hover::before {
      left: -85%;
    }

    .cosmic-btn:hover .cosmic-btn__arrow {
      transform: none;
    }
  }
</style>
