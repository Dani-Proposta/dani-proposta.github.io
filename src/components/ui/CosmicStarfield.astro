
---
/* Gerador determinístico de estrelas */
let seed = 0xA57F3A9;

function random() {
  seed ^= seed << 13;
  seed ^= seed >>> 17;
  seed ^= seed << 5;

  return (seed >>> 0) / 4294967296;
}

/* Cria variações sem depender do navegador */
const stars = Array.from({ length: 1050 }, (_, index) => {
  const typeRoll = random();

  const type =
    typeRoll < 0.74
      ? "small"
      : typeRoll < 0.94
        ? "glow"
        : "flare";

  const colors = [
    "#EAE4FF",
    "#D3BAFF",
    "#A8BFFF",
    "#FFCDAF"
  ];

  const colorRoll = random();

  const color =
    colorRoll < 0.55
      ? colors[0]
      : colorRoll < 0.82
        ? colors[1]
        : colorRoll < 0.94
          ? colors[2]
          : colors[3];

  const size =
    type === "flare"
      ? 2.1 + random() * 1.4
      : type === "glow"
        ? 1.3 + random() * 1.2
        : 0.6 + random() * 0.9;

  const low = 0.08 + random() * 0.2;
  const high = 0.55 + random() * 0.45;

  return {
    id: index,
    type,
    color,
    x: +(random() * 100).toFixed(2),
    y: +(random() * 100).toFixed(2),
    size: +size.toFixed(2),
    low: +low.toFixed(2),
    high: +high.toFixed(2),
    twinkle: +(3 + random() * 9).toFixed(2),
    drift: +(16 + random() * 34).toFixed(2),
    delay: +(-random() * 30).toFixed(2),
    driftDelay: +(-random() * 40).toFixed(2),
    dx: +((random() - 0.5) * 30).toFixed(2),
    dy: +((random() - 0.5) * 34).toFixed(2)
  };
});
---

<div class="cosmic-starfield" aria-hidden="true">
  {stars.map((star) => (
    <span
      class:list={[
        "cosmic-starfield__star",
        `cosmic-starfield__star--${star.type}`
      ]}
      style={`
        --x: ${star.x}%;
        --y: ${star.y}%;
        --size: ${star.size}px;
        --light: ${star.color};
        --low: ${star.low};
        --high: ${star.high};
        --twinkle: ${star.twinkle}s;
        --drift: ${star.drift}s;
        --delay: ${star.delay}s;
        --drift-delay: ${star.driftDelay}s;
        --dx: ${star.dx}px;
        --dy: ${star.dy}px;
      `}
    />
  ))}
</div>

<style>
  /* Mantém as estrelas atrás do conteúdo */
  :global(body) {
    position: relative;
    isolation: isolate;
  }

  /* Camada global */
  .cosmic-starfield {
    position: fixed;
    inset: 0;
    z-index: -1;

    overflow: hidden;
    pointer-events: none;
  }

  /* Cada estrela tem posição e ritmo próprios */
  .cosmic-starfield__star {
    position: absolute;

    top: var(--y);
    left: var(--x);

    width: var(--size);
    height: var(--size);

    border-radius: 50%;
    background: var(--light);

    opacity: var(--low);

    animation:
      cosmic-twinkle
        var(--twinkle)
        ease-in-out
        var(--delay)
        infinite alternate,
      cosmic-drift
        var(--drift)
        ease-in-out
        var(--drift-delay)
        infinite alternate;
  }

  /* Estrelas pequenas */
  .cosmic-starfield__star--small {
    box-shadow:
      0 0 3px var(--light);
  }

  /* Estrelas com aura */
  .cosmic-starfield__star--glow {
    box-shadow:
      0 0 5px 1px var(--light),
      0 0 13px 1px var(--light);
  }

  /* Estrelas mais intensas */
  .cosmic-starfield__star--flare {
    box-shadow:
      0 0 6px 2px var(--light),
      0 0 17px 3px var(--light),
      0 0 28px 5px rgba(175, 117, 255, 0.15);
  }

  /* Pequeno brilho em forma de cruz */
  .cosmic-starfield__star--flare::after {
    content: "";

    position: absolute;
    inset: -6px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--light),
        transparent
      ) center / 100% 1px no-repeat,
      linear-gradient(
        180deg,
        transparent,
        var(--light),
        transparent
      ) center / 1px 100% no-repeat;

    opacity: 0.35;
  }

  /* Cintilação independente */
  @keyframes cosmic-twinkle {
    0% {
      opacity: var(--low);
    }

    45% {
      opacity: var(--high);
    }

    70% {
      opacity: calc(var(--low) + 0.12);
    }

    100% {
      opacity: var(--high);
    }
  }

  /* Deslocamento orgânico e discreto */
  @keyframes cosmic-drift {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(
        var(--dx),
        var(--dy),
        0
      );
    }
  }

  /* Alguns ritmos de cintilação são diferentes */
  .cosmic-starfield__star:nth-child(7n) {
    animation-name:
      cosmic-twinkle-alt,
      cosmic-drift;
  }

  @keyframes cosmic-twinkle-alt {
    0%, 35% {
      opacity: var(--low);
    }

    48%, 54% {
      opacity: var(--high);
    }

    100% {
      opacity: var(--low);
    }
  }

  /* Reduz quantidade de estrelas no celular */
  @media (max-width: 768px) {
    .cosmic-starfield__star:nth-child(n + 56) {
      display: none;
    }
  }

  /* Acessibilidade */
  @media (prefers-reduced-motion: reduce) {
    .cosmic-starfield__star {
      animation: none;
      opacity: var(--high);
    }
  }
</style>


<script>
  /* Gera um novo céu a cada carregamento */
  function regenerateStars() {
    const stars = document.querySelectorAll<HTMLElement>(
      ".cosmic-starfield__star"
    );

    const random = (min: number, max: number) =>
      min + Math.random() * (max - min);

    const colors = [
      "#EAE4FF",
      "#D3BAFF",
      "#A8BFFF",
      "#FFCDAF"
    ];

    stars.forEach((star) => {
      /* Sorteia o tipo de estrela */
      const roll = Math.random();

      const type =
        roll < 0.74
          ? "small"
          : roll < 0.94
            ? "glow"
            : "flare";

      star.classList.remove(
        "cosmic-starfield__star--small",
        "cosmic-starfield__star--glow",
        "cosmic-starfield__star--flare"
      );

      star.classList.add(
        `cosmic-starfield__star--${type}`
      );

      /* Sorteia tamanho, cor e luminosidade */
      const size =
        type === "flare"
          ? random(2.1, 3.5)
          : type === "glow"
            ? random(1.3, 2.5)
            : random(0.6, 1.5);

      const color =
        colors[Math.floor(Math.random() * colors.length)];

      /* Atualiza todas as propriedades da estrela */
      const properties = {
        "--x": `${random(0, 100).toFixed(2)}%`,
        "--y": `${random(0, 100).toFixed(2)}%`,
        "--size": `${size.toFixed(2)}px`,
        "--light": color,
        "--low": random(0.08, 0.28).toFixed(2),
        "--high": random(0.55, 1).toFixed(2),
        "--twinkle": `${random(3, 12).toFixed(2)}s`,
        "--drift": `${random(16, 50).toFixed(2)}s`,
        "--delay": `${random(-30, 0).toFixed(2)}s`,
        "--drift-delay": `${random(-40, 0).toFixed(2)}s`,
        "--dx": `${random(-15, 15).toFixed(2)}px`,
        "--dy": `${random(-17, 17).toFixed(2)}px`
      };

      Object.entries(properties).forEach(([key, value]) => {
        star.style.setProperty(key, value);
      });
    });
  }

  /* Novo universo ao abrir ou atualizar a página */
  regenerateStars();

  /* Novo universo ao navegar com Astro ClientRouter */
  document.addEventListener(
    "astro:after-swap",
    regenerateStars
  );
</script>
