
---
import { portfolioContact } from "../../config/site";

type ChannelId =
  | "email"
  | "whatsapp"
  | "discord"
  | "github";

interface ContactChannel {
  id: ChannelId;
  title: string;
  description: string;
  href: string;
  external: boolean;
}

// Aceita username ou número de telefone.
const whatsappValue = portfolioContact.whatsapp
  .trim()
  .replace(/^@/, "");

const whatsappIsPhone =
  /^\+?[0-9().\s-]+$/.test(whatsappValue) &&
  /\d/.test(whatsappValue);

const whatsappHref = whatsappValue
  ? `https://wa.me/${
      whatsappIsPhone
        ? whatsappValue.replace(/\D/g, "")
        : encodeURIComponent(whatsappValue)
    }`
  : "";

// Canais de contato.
const channels: ContactChannel[] = [
  {
    id: "email",
    title: "E-mail",
    description: "Propostas e orçamentos",
    href: portfolioContact.email.trim()
      ? `mailto:${portfolioContact.email.trim()}`
      : "",
    external: false
  },
  {
    id: "whatsapp",
    title: "WhatsApp",
    description: "Conversas diretas",
    href: whatsappHref,
    external: true
  },
  {
    id: "discord",
    title: "Discord",
    description: "Comunicação online",
    href: portfolioContact.discord.trim(),
    external: true
  },
  {
    id: "github",
    title: "GitHub",
    description: "Código e projetos",
    href: portfolioContact.github.trim(),
    external: true
  }
];

// Exibe somente os canais configurados.
const activeChannels = channels.filter(
  (channel) => channel.href.length > 0
);

import SectionMarker from "../ui/SectionMarker.astro";
import PanelFrame from "../ui/PanelFrame.astro";

---

<section
  class="contact-section"
  id="contato"
  aria-labelledby="contact-title"
>
  <div class="contact-panel tech-panel">
    <PanelFrame />
    <div class="contact-intro">
      <SectionMarker
        number="06"
        label="CONTATO / COLABORAÇÃO"
        />


        <h2 id="contact-title">
        Vamos construir
        <span class="glow-word">algo juntos?</span>
        </h2>


      <p>
        Tem uma ideia ou projeto em mente?
        Escolha um canal para conversarmos
        sobre os objetivos e possibilidades.
      </p>

      <div class="contact-divider"></div>

      <span class="contact-note">
        Desenvolvimento · Automação · Audiovisual
      </span>
    </div>

    <div
      class:list={[
        "contact-grid",
        {
          "contact-grid--single":
            activeChannels.length === 1
        }
      ]}
    >
      {activeChannels.map((channel) => (
        <a
          class="contact-card tech-panel"
          data-channel={channel.id}
          href={channel.href}
          target={channel.external ? "_blank" : undefined}
          rel={channel.external
            ? "noopener noreferrer"
            : undefined}
        >
            <PanelFrame />
          <div class="contact-card__top">
            <span
              class="contact-card__icon"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                width="23"
                height="23"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {channel.id === "email" && (
                  <>
                    <rect
                      x="3"
                      y="5"
                      width="18"
                      height="14"
                      rx="2"
                    />
                    <path d="m3 7 9 6 9-6" />
                  </>
                )}

                {channel.id === "whatsapp" && (
                  <>
                    <path
                      d="M20 11.5a8 8 0 0 1-11.5 7.2L4 20l1.3-4.5A8 8 0 1 1 20 11.5Z"
                    />
                    <path
                      d="M9 9c.8 2.5 2.5 4.2 5 5l1.5-1"
                    />
                  </>
                )}

                {channel.id === "discord" && (
                  <>
                    <path
                      d="M7 7 10 6l1 2h2l1-2 3 1c1.5 2.8 2 5 2 8l-3 2-1-2"
                    />
                    <path
                      d="M7 7C5.5 9.8 5 12 5 15l3 2 1-2"
                    />
                    <path
                      d="M8 15c2.5 1.3 5.5 1.3 8 0"
                    />
                    <circle cx="9" cy="12" r="0.7" />
                    <circle cx="15" cy="12" r="0.7" />
                  </>
                )}

                {channel.id === "github" && (
                  <>
                    <path
                      d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.1-1.5 6.1-6.7A5.2 5.2 0 0 0 18.8 5a4.8 4.8 0 0 0-.1-3S17.5 1.7 15 3.5a13.6 13.6 0 0 0-7 0C5.5 1.7 4.3 2 4.3 2A4.8 4.8 0 0 0 4.2 5 5.2 5.2 0 0 0 2.8 8.7c0 5.2 3.1 6.4 6.1 6.7A5.2 5.2 0 0 0 18.8 5"
                    />
                  </>
                )}
              </svg>
            </span>

            <span
              class="contact-card__arrow"
              aria-hidden="true"
            >
              ↗
            </span>
          </div>

          <div class="contact-card__info">
            <h3>{channel.title}</h3>
            <p>{channel.description}</p>
          </div>

          {channel.external && (
            <span class="sr-only">
              (abre em nova aba)
            </span>
          )}
        </a>
      ))}

      {activeChannels.length === 0 && (
        <div class="contact-empty">
          <p>
            Os canais profissionais serão
            disponibilizados em breve.
          </p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* Seção */
  .contact-section {
    padding-block: 3rem 6rem;
  }

  /* Painel principal */
  .contact-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    display: grid;
    grid-template-columns:
      minmax(0, 0.95fr)
      minmax(0, 1.5fr);

    gap: 3rem;
    align-items: center;

    padding: clamp(1.5rem, 4vw, 3rem);

    border: 1px solid var(--color-border-highlight);
    border-radius: var(--radius-lg);

    background:
      radial-gradient(
        ellipse at 5% 30%,
        rgba(144, 87, 240, 0.14),
        transparent 57%
      ),
      linear-gradient(
        135deg,
        #15192d,
        #0d1020
      );

    box-shadow:
      var(--shadow-panel),
      0 0 36px rgba(177, 139, 255, 0.07);
  }

  /* Detalhe luminoso superior */
  .contact-panel::before {
    content: "";
    position: absolute;
    top: 0;
    left: 15%;

    width: 55%;
    height: 2px;

    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      transparent
    );
  }

  /* Apresentação */
  .contact-intro {
    position: relative;
    z-index: 1;
  }

  .contact-eyebrow {
    color: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.17em;
  }

  .contact-intro h2 {
    margin-block: 1rem;

    font-size: clamp(2rem, 3.8vw, 3.1rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .contact-intro h2 span {
    color: var(--color-accent);
  }

  .contact-intro p {
    max-width: 430px;
    margin: 0;
    font-size: 0.95rem;
  }

  .contact-divider {
    width: 75px;
    height: 2px;
    margin-block: 2rem 1rem;

    background: linear-gradient(
      90deg,
      var(--color-accent),
      transparent
    );
  }

  .contact-note {
    color: var(--color-muted);
    font-size: 0.76rem;
    letter-spacing: 0.03em;
  }

  /* Grade */
  .contact-grid {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    min-width: 0;
  }

  .contact-grid--single {
    grid-template-columns: 1fr;
  }

  /* Cards */
  .contact-card {
    --channel-color: var(--color-accent);

    position: relative;
    overflow: hidden;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.3rem;

    min-height: 145px;
    min-width: 0;
    padding: 1.2rem;

    color: var(--color-text);
    text-decoration: none;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    background:
      linear-gradient(
        140deg,
        rgba(177, 139, 255, 0.055),
        transparent 70%
      ),
      var(--color-surface);

    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .contact-card:hover {
    transform: translateY(-4px);
    border-color: var(--channel-color);

    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.24),
      0 0 22px rgba(177, 139, 255, 0.12);
  }

  /* Detalhe de engenharia */
  .contact-card::before {
    content: "";
    position: absolute;

    top: 0;
    right: 0;

    width: 35px;
    height: 35px;

    border-top: 1px solid var(--channel-color);
    border-right: 1px solid var(--channel-color);

    border-top-right-radius: var(--radius-md);
    opacity: 0.5;
  }

  /* Cores dos canais */
  .contact-card[data-channel="whatsapp"] {
    --channel-color: #8ce7c2;
  }

  .contact-card[data-channel="discord"] {
    --channel-color: #97a4ff;
  }

  .contact-card[data-channel="github"] {
    --channel-color: var(--color-accent-warm);
  }

  /* Ícones */
  .contact-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-card__icon {
    display: grid;
    place-items: center;

    width: 43px;
    height: 43px;

    color: var(--channel-color);

    border: 1px solid var(--color-border);
    border-radius: 12px;

    background: rgba(177, 139, 255, 0.07);
  }

  .contact-card__arrow {
    color: var(--color-muted);
    font-size: 1.2rem;

    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .contact-card:hover .contact-card__arrow {
    color: var(--channel-color);
    transform: translate(2px, -2px);
  }

  /* Textos */
  .contact-card__info h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }

  .contact-card__info p {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .contact-empty {
    padding: 1.5rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }

  /* Acessibilidade */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Responsividade */
  @media (max-width: 900px) {
    .contact-panel {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-card {
      min-height: 120px;
    }
  }

  /* Movimento reduzido */
  @media (prefers-reduced-motion: reduce) {
    .contact-card,
    .contact-card__arrow {
      transition: none;
    }

    .contact-card:hover,
    .contact-card:hover .contact-card__arrow {
      transform: none;
    }
  }
</style>
