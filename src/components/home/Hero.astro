---
import SectionMarker from "../ui/SectionMarker.astro";
import CosmicButton from "../ui/CosmicButton.astro";
import HeroOrnaments from "./HeroOrnaments.astro";
---

<section class="cosmic-hero" id="inicio" aria-labelledby="hero-title">
  <div class="cosmic-hero__content">
    <SectionMarker
      number="01"
      label="PROGRAMAÇÃO · EDIÇÃO DE VÍDEO"
    />

    <h1 id="hero-title">
      Bem vindo ao meu{" "}<span class="glow-word">Portfólio.</span>
    </h1>

    <p class="cosmic-hero__description">
      Desenvolvimento de software, automações
      e edição de vídeo para transformar ideias
      em soluções práticas.
    </p>

    <div class="hero-actions">
      <CosmicButton href="/#projetos" variant="primary">
        Explorar projetos
      </CosmicButton>

      <CosmicButton href="/#contato" variant="secondary">
        Entrar em contato
      </CosmicButton>
    </div>

    <div class="cosmic-hero__specialties">
      <span>Back-end e APIs</span>
      <span>Automações</span>
      <span>Edição audiovisual</span>
    </div>
  </div>

  <HeroOrnaments />
</section>

<style>
  /* Hero: aparência original do desktop */
  .cosmic-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 570px;
    padding-block: 5rem;
  }

  .cosmic-hero__content {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 620px;
    min-width: 0;
  }

  h1 {
    margin-block: 1.5rem;
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  /* Preserva o gradiente aprovado para o título */
  h1 span {
    background: linear-gradient(100deg, #d4bbff, #9e80ff, #7b9aff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cosmic-hero__description {
    max-width: 490px;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  /* Botões atuais: CosmicButton, não o antigo hero-button */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .cosmic-hero__specialties {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2.5rem;
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  /* Tablets: evita a altura exagerada e o conteúdo espremido */
  @media (max-width: 1024px) {
    .cosmic-hero {
      min-height: 530px;
      padding-block: 4rem 4.5rem;
    }

    .cosmic-hero__content {
      max-width: min(620px, 100%);
    }

    h1 {
      font-size: clamp(2.75rem, 6.5vw, 4.4rem);
    }
  }

  /* Tablet estreito: conteúdo no topo e respiro para a arte */
  @media (max-width: 760px) {
    .cosmic-hero {
      min-height: 550px;
      align-items: flex-start;
      padding-block: 3.25rem 5rem;
    }

    .cosmic-hero__content {
      max-width: 100%;
    }

    h1 {
      max-width: 14ch;
      margin-block: 1.2rem;
      font-size: clamp(2.35rem, 7.2vw, 3.45rem);
      line-height: 1.06;
    }

    .cosmic-hero__description {
      max-width: 34rem;
      font-size: 0.98rem;
      line-height: 1.7;
    }

    .hero-actions {
      gap: 0.75rem;
      margin-top: 1.6rem;
    }

    .cosmic-hero__specialties {
      gap: 0.7rem 1rem;
      margin-top: 1.8rem;
      font-size: 0.75rem;
    }
  }

  /* Celular: ações empilhadas e título legível */
  @media (max-width: 520px) {
    .cosmic-hero {
      min-height: 590px;
      padding-block: 2.75rem 4.75rem;
    }

    h1 {
      max-width: 13ch;
      font-size: clamp(2.05rem, 9.5vw, 2.9rem);
      line-height: 1.08;
    }

    .cosmic-hero__description {
      max-width: 33ch;
      font-size: 0.95rem;
      line-height: 1.65;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      width: min(100%, 320px);
      gap: 0.75rem;
    }

    .hero-actions :global(.cosmic-btn) {
      width: 100%;
      min-height: 48px;
    }

    .cosmic-hero__specialties {
      gap: 0.5rem 0.85rem;
      margin-top: 1.65rem;
      font-size: 0.72rem;
    }
  }
</style>
