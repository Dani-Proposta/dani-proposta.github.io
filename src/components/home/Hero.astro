---
import SectionMarker from "../ui/SectionMarker.astro";

---
<section class="cosmic-hero" aria-labelledby="hero-title">
  <!-- Camada visual decorativa -->



  <!-- Conteúdo profissional -->
  <div class="cosmic-hero__content">
    <SectionMarker
    number="01"
    label="PROGRAMAÇÃO · EDIÇÃO DE VÍDEO"
    />

    <h1 id="hero-title">
      Ideias bem feitas para um 
      <span> mundo real.</span>
    </h1>

    <p class="cosmic-hero__description">
      Desenvolvimento de software, automações
      e edição de vídeo para transformar ideias
      em soluções práticas.
    </p>

    <div class="cosmic-hero__actions">
      <a class="hero-button hero-button--primary" href="/projetos/">
        Ver meus projetos
        <span aria-hidden="true">↗</span>
      </a>

      <a class="hero-button hero-button--secondary" href="/#contato">
        Entrar em contato
      </a>
    </div>

    <div class="cosmic-hero__specialties">
      <span>Back-end e APIs</span>
      <span>Automações</span>
      <span>Edição audiovisual</span>
    </div>
  </div>
</section>


<style>
  /* HERO — ESTRUTURA */

  .cosmic-hero {
    position: relative;
    isolation: isolate;
    overflow: visible;

    display: flex;
    align-items: center;

    min-height: 570px;
    padding-block: 5rem;
  }

  /* CONTEÚDO */

  .cosmic-hero__content {
    position: relative;
    z-index: 5;
    max-width: 620px;
  }

  .cosmic-hero__eyebrow {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  h1 {
    margin-block: 1.5rem;
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  h1 span {
    background: linear-gradient(
      100deg,
      #d4bbff,
      #9e80ff,
      #7b9aff
    );

    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cosmic-hero__description {
    max-width: 490px;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  /* BOTÕES */

  .cosmic-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;

    padding: 0.9rem 1.4rem;

    border-radius: 999px;
    border: 1px solid var(--color-border);

    font-weight: 600;
    text-decoration: none;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .hero-button--primary {
    color: #fff;

    background: linear-gradient(
      110deg,
      #657cf9,
      #a65bed
    );

    border-color: #a88cff;

    box-shadow:
      0 0 25px rgba(145, 95, 255, 0.24);
  }

  .hero-button--secondary {
    color: var(--color-text);
    background: rgba(15, 17, 35, 0.75);
  }

  .hero-button:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-glow);
  }

  /* ESPECIALIDADES */

  .cosmic-hero__specialties {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;

    margin-top: 2.5rem;

    color: var(--color-muted);
    font-size: 0.8rem;
  }

  /* ARTE */

    .cosmic-hero__visual {
    position: absolute;
    z-index: 0;

    width: min(96vw, 1320px);
    aspect-ratio: 1952 / 806;

    /* A imagem ultrapassa o container */
    right: calc(50% - 59vw);
    top: 50%;

    transform: translateY(-50%);
    pointer-events: none;

    /* Mistura a arte com o fundo à esquerda */
    -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, 0.5) 21%,
        black 44%
    );

    mask-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, 0.5) 21%,
        black 44%
    );
    }

    

    .cosmic-hero__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;

    /* Iluminação adicional */
    filter: drop-shadow(
        0 0 34px rgba(172, 95, 255, 0.12)
    );

    /* Integração superior e inferior */
    -webkit-mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0, 0, 0, 0.25) 8%,
        rgba(0, 0, 0, 0.75) 16%,
        black 24%,
        black 66%,
        rgba(0, 0, 0, 0.88) 76%,
        rgba(0, 0, 0, 0.48) 88%,
        transparent 100%
    );

    mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0, 0, 0, 0.25) 8%,
        rgba(0, 0, 0, 0.75) 16%,
        black 24%,
        black 66%,
        rgba(0, 0, 0, 0.88) 76%,
        rgba(0, 0, 0, 0.48) 88%,
        transparent 100%
    );
    }

  /* TELAS MENORES */

  @media (max-width: 760px) {
    .cosmic-hero {
      min-height: 620px;
      align-items: flex-start;
      padding-block: 4rem;
    }

    .cosmic-hero__visual {
    width: 165vw;

    right: -35vw;
    top: 65%;

    opacity: 0.35;
    }

    .cosmic-hero__content {
      max-width: 100%;
    }

    .cosmic-hero__description {
      max-width: 420px;
    }

    .cosmic-hero__specialties {
      gap: 0.8rem;
    }
  }

  /* ACESSIBILIDADE */

  @media (prefers-reduced-motion: reduce) {
    .hero-button {
      transition: none;
    }

    .hero-button:hover {
      transform: none;
    }
  }
</style>

