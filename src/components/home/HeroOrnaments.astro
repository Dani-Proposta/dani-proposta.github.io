
---
import PanelFrame from "../ui/PanelFrame.astro";
---

<div class="hero-ornaments" aria-hidden="true">

  <div class="hero-module tech-panel">
    <PanelFrame />

    <div class="hero-module__inner">

      <div class="hero-module__heading">
        <span class="hero-module__star">✦</span>
        <span>FLUXO CRIATIVO</span>
      </div>

      <div class="hero-module__content">
        <div class="hero-module__step">
          <span class="hero-module__number">01</span>
          <span>IDEIAS</span>
        </div>

        <div class="hero-module__step">
          <span class="hero-module__number">02</span>
          <span>ESTRUTURA</span>
        </div>

        <div class="hero-module__step">
          <span class="hero-module__number">03</span>
          <span>RESULTADOS</span>
        </div>
      </div>

      <div class="hero-module__footer">
        <span class="hero-module__light"></span>
        <span class="hero-module__line"></span>
        <span class="hero-module__symbol">✧</span>
      </div>

    </div>
  </div>

</div>

<style>
  /* Camada decorativa */
  .hero-ornaments {
    position: absolute;
    inset: 0;
    z-index: 3;

    pointer-events: none;
  }

  /* Módulo integrado ao universo */
  .hero-module {
    --panel-energy: rgba(194, 155, 255, 0.76);

    position: absolute;


    right: clamp(12px, 2.5vw, 42px);
    bottom: 5rem;


    width: 196px;
    max-width: calc(100% - 24px);

    padding: 1.35rem 1.25rem;

    border: 1px solid rgba(177, 139, 255, 0.38);
    border-radius: 15px;

    background:
      linear-gradient(
        145deg,
        rgba(177, 139, 255, 0.075),
        transparent 70%
      ),
      rgba(10, 11, 27, 0.66);

    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);

    box-shadow:
      0 12px 34px rgba(0, 0, 0, 0.22),
      0 0 22px rgba(177, 139, 255, 0.1);
  }

  /* Conteúdo acima da decoração */
  .hero-module__inner {
    position: relative;
    z-index: 2;
  }

  /* Identificação */
  .hero-module__heading {
    display: flex;
    align-items: center;
    gap: 0.55rem;

    color: #d1b3ff;

    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.105em;
    white-space: nowrap;

    text-shadow:
      0 0 10px rgba(177, 139, 255, 0.36);
  }

  .hero-module__star {
    color: #e0c7ff;
    font-size: 0.92rem;

    text-shadow:
      0 0 8px #a66cff,
      0 0 18px rgba(177, 139, 255, 0.5);
  }

  /* Etapas do fluxo criativo */
  .hero-module__content {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;

    margin-top: 1.2rem;
  }

  .hero-module__step {
    display: flex;
    align-items: center;
    gap: 0.85rem;

    color: #e8defa;

    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.09em;
  }

  /* Identificadores tecnológicos */
  .hero-module__number {
    display: grid;
    place-items: center;

    width: 25px;
    height: 22px;
    flex-shrink: 0;

    border: 1px solid rgba(177, 139, 255, 0.19);
    border-radius: 5px;

    background: rgba(177, 139, 255, 0.055);

    color: #bb98ec;
    font-family: monospace;
    font-size: 0.62rem;
    font-weight: 700;
  }

  /* Resultado recebe um destaque suave */
  .hero-module__step:last-child {
    color: #f1e6ff;
  }

  .hero-module__step:last-child
  .hero-module__number {
    color: #ead5ff;

    border-color: rgba(177, 139, 255, 0.42);

    box-shadow:
      0 0 9px rgba(177, 139, 255, 0.12);
  }

  /* Assinatura luminosa inferior */
  .hero-module__footer {
    display: flex;
    align-items: center;
    gap: 0.65rem;

    margin-top: 1.2rem;
  }

  .hero-module__light {
    width: 5px;
    height: 5px;
    flex-shrink: 0;

    border-radius: 50%;
    background: #c9a5ff;

    box-shadow:
      0 0 8px #b18bff,
      0 0 16px rgba(177, 139, 255, 0.5);
  }

  .hero-module__line {
    flex: 1;
    height: 1px;

    background: linear-gradient(
      90deg,
      rgba(177, 139, 255, 0.85),
      rgba(177, 139, 255, 0.05)
    );
  }

  .hero-module__symbol {
    color: #d2b0ff;
    font-size: 0.85rem;

    text-shadow:
      0 0 9px rgba(177, 139, 255, 0.45);
  }

  /* Reduz efeitos nas telas menores */
  @media (max-width: 1180px) {
    .hero-module {
      display: none;
    }
  }

  /* Acessibilidade */
  @media (prefers-reduced-motion: reduce) {
    .hero-module {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
