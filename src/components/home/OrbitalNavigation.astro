
---
const chapters = [
  { id: "inicio", number: "01", label: "Início" },
  { id: "servicos", number: "02", label: "Serviços" },
  { id: "stack", number: "03", label: "Stack" },
  { id: "projetos", number: "04", label: "Projetos" },
  { id: "faq", number: "05", label: "FAQ" },
  { id: "contato", number: "06", label: "Contato" }
];
---

<nav
  class="orbital-nav"
  aria-label="Navegação por capítulos"
  data-orbital-nav
>
  <div class="orbital-nav__rail">

    <div class="orbital-nav__stops">
      {chapters.map((chapter, index) => (
        <a
          href={`/#${chapter.id}`}
          class:list={[
            "orbital-nav__stop",
            { "is-active": index === 0 }
          ]}
          data-chapter={chapter.id}
          data-label={chapter.label}
          aria-label={`Ir para ${chapter.label}`}
          aria-current={index === 0 ? "location" : undefined}
        >
          <span class="orbital-nav__beam" aria-hidden="true"></span>
          <span class="orbital-nav__dot" aria-hidden="true"></span>
        </a>
      ))}
    </div>

    <div class="orbital-nav__cursor" aria-hidden="true">
      <span class="orbital-nav__number" data-orbital-number>
        01
      </span>
      <span class="orbital-nav__orb"></span>
    </div>

  </div>
</nav>

<style>
  /* Estrutura fixa */
  .orbital-nav {
    position: fixed;
    z-index: 90;

    top: 50%;
    left: 16px;

    width: 48px;
    transform: translateY(-50%);
  }

  .orbital-nav__rail {
    --compact-step: 24px;
    --expanded-step: 110px;
    --cursor-y: 110px;

    position: relative;
    width: 48px;
    height: 230px;
  }

  /* Capítulos */
  .orbital-nav__stops {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .orbital-nav__stop {
    position: relative;
    display: block;
    flex: 0 0 var(--compact-step);

    width: 48px;
    min-height: 0;

    text-decoration: none;

    transition:
      flex-basis 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Somente o capítulo atual se expande */
  .orbital-nav__stop.is-active {
    flex-basis: var(--expanded-step);
  }

  /* Pontos compactos */
  .orbital-nav__dot {
    position: absolute;
    left: 35px;
    top: 50%;

    width: 5px;
    height: 5px;

    transform: translate(-50%, -50%);
    border-radius: 50%;

    background: #655074;

    transition:
      background 250ms ease,
      box-shadow 250ms ease,
      opacity 250ms ease;
  }

  /* Capítulos percorridos */
  .orbital-nav__stop.is-past .orbital-nav__dot {
    width: 6px;
    height: 6px;

    background: #BF91FF;
    box-shadow: 0 0 8px rgba(177, 139, 255, 0.65);
  }

  /* O cursor substitui o ponto ativo */
  .orbital-nav__stop.is-active .orbital-nav__dot {
    opacity: 0;
  }

  /* Linha do capítulo expandido */
  .orbital-nav__beam {
    position: absolute;

    top: 8px;
    bottom: auto;

    height: calc(
    var(--expanded-step) - 20px
    + var(--beam-extension, 0px)
    );
    left: 34.5px;

    width: 1px;

    background: linear-gradient(
      to bottom,
      rgba(177, 139, 255, 0.25),
      rgba(177, 139, 255, 0.85),
      rgba(215, 167, 255, 0.45)
    );

    box-shadow:
      0 0 9px rgba(177, 139, 255, 0.45);

    opacity: 0;
    pointer-events: none;

    transition: opacity 320ms ease;
  }

  .orbital-nav__stop.is-active .orbital-nav__beam {
    opacity: 1;
  }

  /* Cursor que acompanha o scroll */
  .orbital-nav__cursor {
    position: absolute;
    z-index: 4;

    top: 0;
    left: 0;

    display: flex;
    align-items: center;
    gap: 7px;

    width: 48px;
    height: 20px;

    pointer-events: none;

    transform:
      translate3d(0, var(--cursor-y), 0)
      translateY(-50%);

    will-change: transform;
  }

  /* Número acompanha a bolinha */
  .orbital-nav__number {
    width: 22px;
    flex-shrink: 0;

    color: #DCBBFF;
    font-size: 0.71rem;
    font-weight: 700;
    text-align: right;
    font-variant-numeric: tabular-nums;

    text-shadow:
      0 0 10px rgba(177, 139, 255, 0.65);
  }

  /* Bolinha principal */
  .orbital-nav__orb {
    position: relative;

    width: 12px;
    height: 12px;
    flex: 0 0 12px;

    border: 1.5px solid #D7A7FF;
    border-radius: 50%;

    background: #140C25;

    box-shadow:
      0 0 9px rgba(177, 139, 255, 0.85),
      0 0 21px rgba(177, 139, 255, 0.25);
  }

  .orbital-nav__orb::after {
    content: "";
    position: absolute;
    inset: 3px;

    border-radius: 50%;
    background: #F2DEFF;
  }

  /* Informação ao passar o cursor */
  .orbital-nav__stop::after {
    content: attr(data-label);

    position: absolute;
    z-index: 5;
    left: 53px;
    top: 50%;

    padding: 0.45rem 0.75rem;

    color: #E8D7FF;
    font-size: 0.73rem;
    font-weight: 600;
    white-space: nowrap;

    border: 1px solid #664A88;
    border-radius: 8px;

    background: rgba(15, 12, 30, 0.95);

    opacity: 0;
    pointer-events: none;

    transform: translate(-6px, -50%);

    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .orbital-nav__stop:hover::after,
  .orbital-nav__stop:focus-visible::after {
    opacity: 1;
    transform: translate(0, -50%);
  }

  /* Feedback de interação */
  .orbital-nav__stop:hover .orbital-nav__dot {
    background: #E3C4FF;
    box-shadow: 0 0 10px #B18BFF;
  }

  .orbital-nav__stop:focus-visible {
    outline: 2px solid #CCA0FF;
    outline-offset: 2px;
    border-radius: 5px;
  }

  /* Telas compactas */
  @media (max-width: 1080px) {
    .orbital-nav {
      display: none;
    }
  }

  /* Movimento reduzido */
  @media (prefers-reduced-motion: reduce) {
    .orbital-nav__stop,
    .orbital-nav__dot,
    .orbital-nav__beam,
    .orbital-nav__stop::after {
      transition: none;
    }
  }
</style>

<script>
  const orbital = document.querySelector<HTMLElement>(
    "[data-orbital-nav]"
  );

  if (orbital) {
    const chapterIds = [
      "inicio",
      "servicos",
      "stack",
      "projetos",
      "faq",
      "contato"
    ];

    const rail = orbital.querySelector<HTMLElement>(
      ".orbital-nav__rail"
    );

    const stops = Array.from(
      orbital.querySelectorAll<HTMLAnchorElement>(
        "[data-chapter]"
      )
    );

    const number = orbital.querySelector<HTMLElement>(
      "[data-orbital-number]"
    );

    const headerLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        "[data-nav-section]"
      )
    );

    let activeIndex = -1;
    let frame = 0;

    // Atualiza as seções selecionadas.
    function updateActive(index: number) {
      if (index === activeIndex || !number) return;

      activeIndex = index;

      number.textContent = String(index + 1).padStart(2, "0");

      stops.forEach((stop, i) => {
        const current = i === index;

        stop.classList.toggle("is-active", current);
        stop.classList.toggle("is-past", i < index);

        if (current) {
          stop.setAttribute("aria-current", "location");
        } else {
          stop.removeAttribute("aria-current");
        }
      });

      // A Stack pertence a Serviços no Header.
      const headerId =
        chapterIds[index] === "stack"
          ? "servicos"
          : chapterIds[index];

      headerLinks.forEach((link) => {
        const current =
          link.dataset.navSection === headerId;

        link.classList.toggle("is-active", current);

        if (current) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    }

    // Acompanha a posição real da página.
    function updateNavigation() {
      if (!rail) return;

      const scrollY = window.scrollY;
      const referenceLine = Math.min(
        window.innerHeight * 0.3,
        220
      );

      const checkpoints = chapterIds.map((id) => {
        const section = document.getElementById(id);

        return section
          ? scrollY +
              section.getBoundingClientRect().top -
              referenceLine
          : Infinity;
      });

      let index = 0;

      for (let i = 1; i < checkpoints.length; i++) {
        if (scrollY >= checkpoints[i]) {
          index = i;
        }
      }

      const maxScroll = Math.max(
        0,
        document.documentElement.scrollHeight -
          window.innerHeight
      );

      if (maxScroll > 0 && scrollY >= maxScroll - 2) {
        index = chapterIds.length - 1;
      }

      // Calcula o percurso entre dois capítulos.
      let fraction = 0;

      if (index < chapterIds.length - 1) {
        const start = checkpoints[index];
        const end = checkpoints[index + 1];

        if (
          Number.isFinite(start) &&
          Number.isFinite(end) &&
          end > start
        ) {
          fraction = Math.max(
            0,
            Math.min(1, (scrollY - start) / (end - start))
          );
        }
      }

      const virtualPosition = index + fraction;

      // Lê as dimensões definidas no CSS.
      const styles = getComputedStyle(rail);

      const compact = parseFloat(
        styles.getPropertyValue("--compact-step")
      ) || 24;

      const expanded = parseFloat(
        styles.getPropertyValue("--expanded-step")
      ) || 110;

      // Posiciona a bolinha continuamente.

        const cursorY =
        expanded - 12 + compact * virtualPosition;

        rail.style.setProperty(
        "--beam-extension",
        `${compact * fraction}px`
        );


      rail.style.setProperty(
        "--cursor-y",
        `${cursorY}px`
      );

      updateActive(index);
    }

    // Limita a atualização a um frame por vez.
    function scheduleUpdate() {
      if (frame) return;

      frame = requestAnimationFrame(() => {
        frame = 0;
        updateNavigation();
      });
    }

    window.addEventListener("scroll", scheduleUpdate, {
      passive: true
    });

    window.addEventListener("resize", scheduleUpdate);
    window.addEventListener("hashchange", scheduleUpdate);
    window.addEventListener("load", scheduleUpdate);

    scheduleUpdate();
  }
</script>
