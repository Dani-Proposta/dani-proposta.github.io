
---
import { getCollection } from "astro:content";

const featuredProjects = (
  await getCollection("projects", ({ data }) => data.featured === true)
)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "pt-BR"))
  .slice(0, 3);

const statusLabels: Record<string, string> = {
  "concluido": "Concluído",
  "concluído": "Concluído",
  "em-andamento": "Em andamento",
  "em-desenvolvimento": "Em desenvolvimento",
  "planejado": "Planejado"
};
import SectionMarker from "../ui/SectionMarker.astro";
import PanelFrame from "../ui/PanelFrame.astro";
---

<section
  class="featured-section"
  id="projetos"
  aria-labelledby="featured-title"
>
  <div class="featured-layout">
    <div class="featured-intro">
        <SectionMarker
        number="04"
        label="PROJETOS EM DESTAQUE"
        />


        <h2 id="featured-title">
        Da ideia à
        <span class="glow-word glow-word--warm">
            execução.
        </span>
        </h2>


      <p>
        Uma seleção de projetos que demonstram
        minhas habilidades em desenvolvimento
        e produção audiovisual.
      </p>

      <a class="featured-all" href="/projetos/">
        Ver todos os projetos
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    {featuredProjects.length > 0 ? (
      <div class="featured-grid">
        {featuredProjects.map((project) => {
          const isVideo = project.data.service === "edicao-video";

          return (
            <a
              class="featured-card"
              href={`/projetos/${project.id}/`}
              data-kind={project.data.service}
            >  
            <PanelFrame />
              <div class="featured-card__art" aria-hidden="true">
                <span class="featured-card__orb"></span>
                <span class="featured-card__symbol">
                  {isVideo ? "▶" : "</>"}
                </span>
              </div>

              <div class="featured-card__body">
                <div class="featured-card__metadata">
                  <span>
                    {isVideo ? "AUDIOVISUAL" : "DESENVOLVIMENTO"}
                  </span>

                  <span class="featured-card__status">
                    {statusLabels[project.data.status] ??
                      project.data.status}
                  </span>
                </div>

                <h3>{project.data.title}</h3>

                <p>{project.data.summary}</p>

                <div class="featured-card__footer">
                  <div class="featured-card__tags">
                    {project.data.technologies
                      .slice(0, 3)
                      .map((technology) => (
                        <span>{technology}</span>
                      ))}
                  </div>

                  <span class="featured-card__arrow" aria-hidden="true">
                    ↗
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="featured-empty">
        <span class="featured-empty__icon" aria-hidden="true">
          ◇
        </span>

        <h3>Novos projetos em preparação</h3>

        <p>
          Esta seção receberá os projetos selecionados
          para destaque conforme forem documentados.
        </p>
      </div>
    )}
  </div>
</section>

<style>
  .featured-section {
    padding-block: 3rem 5rem;
  }

  .featured-layout {
    display: grid;
    grid-template-columns: minmax(200px, 0.85fr) minmax(0, 2.4fr);
    align-items: start;
    gap: 1.25rem;
  }

  .featured-intro {
    padding: 1.25rem 1rem 0 0;
  }

  .featured-eyebrow {
    color: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .featured-intro h2 {
    margin-block: 1rem;
    font-size: clamp(1.6rem, 2.7vw, 2.2rem);
  }

  .featured-intro p {
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .featured-all {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;

    color: var(--color-text);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;

    background: linear-gradient(110deg, #657cf9, #a65bed);
    border-radius: 999px;
  }

  .featured-all:hover {
    box-shadow: var(--shadow-glow);
  }

  .featured-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
    min-width: 0;
  }

  /* Cards */
  .featured-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-width: 0;

    color: var(--color-text);
    text-decoration: none;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-panel);

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .featured-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-highlight);
    box-shadow: var(--shadow-panel), var(--shadow-glow);
  }

  /* Ilustração abstrata */
  .featured-card__art {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;

    height: 145px;

    background:
      radial-gradient(
        ellipse at 65% 55%,
        rgba(160, 102, 255, 0.3),
        transparent 55%
      ),
      linear-gradient(140deg, #101428, #28194a 75%, #111728);
  }

  .featured-card__art::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.18;

    background-image:
      linear-gradient(#aaa0dc 1px, transparent 1px),
      linear-gradient(90deg, #aaa0dc 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .featured-card__orb {
    position: absolute;
    width: 115px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(193, 148, 255, 0.7);
    box-shadow:
      0 0 28px rgba(153, 85, 255, 0.25),
      inset 0 0 28px rgba(153, 85, 255, 0.2);
    transform: rotate(-20deg) scaleY(0.5);
  }

  .featured-card__symbol {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;

    width: 54px;
    height: 54px;
    border-radius: 14px;

    color: #dfc7ff;
    background: rgba(12, 11, 30, 0.86);
    border: 1px solid rgba(177, 139, 255, 0.55);

    font-size: 1.2rem;
    font-weight: 700;
  }

  /* Cor alternativa para edição */
  .featured-card[data-kind="edicao-video"]
  .featured-card__art {
    background:
      radial-gradient(
        ellipse at 65% 55%,
        rgba(255, 177, 122, 0.25),
        transparent 55%
      ),
      linear-gradient(140deg, #15152b, #43243e);
  }

  .featured-card[data-kind="edicao-video"]
  .featured-card__symbol {
    color: var(--color-accent-warm);
    border-color: rgba(255, 177, 122, 0.45);
  }

  /* Texto e informações */
  .featured-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.8rem;
    padding: 1.2rem;
  }

  .featured-card__metadata {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;

    color: var(--color-accent);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .featured-card__status {
    color: var(--color-muted);
    font-weight: 400;
    letter-spacing: 0;
  }

  .featured-card h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .featured-card p {
    margin: 0;
    font-size: 0.83rem;
    line-height: 1.6;
  }

  .featured-card__footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.6rem;
  }

  .featured-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .featured-card__tags span {
    padding: 0.3rem 0.5rem;

    color: var(--color-muted);
    background: rgba(255,255,255,0.025);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.68rem;
  }

  .featured-card__arrow {
    display: grid;
    place-items: center;
    flex: 0 0 32px;

    width: 32px;
    height: 32px;
    border: 1px solid var(--color-border-highlight);
    border-radius: 50%;
    color: var(--color-text);
  }

  /* Estado vazio */
  .featured-empty {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 255px;
    padding: 2rem;

    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .featured-empty__icon {
    color: var(--color-accent);
    font-size: 2rem;
  }

  .featured-empty h3 {
    margin-bottom: 0;
  }

  /* Responsividade */
  @media (max-width: 900px) {
    .featured-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-card {
      transition: none;
    }

    .featured-card:hover {
      transform: none;
    }
  }
</style>
