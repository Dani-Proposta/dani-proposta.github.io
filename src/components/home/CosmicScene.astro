
---
import Hero from "./Hero.astro";
import ServicesSection from "./ServicesSection.astro";
---

<div class="cosmic-scene">

  <!-- Iluminação que continua atrás dos serviços -->
  <div
    class="cosmic-scene__ambient"
    aria-hidden="true"
  ></div>

  <!-- Arte compartilhada -->
  <div
    class="cosmic-scene__art"
    aria-hidden="true"
  >
    <img
      class="cosmic-scene__image"
      src="/images/buraco-negro-dani.webp"
      alt=""
      width="1952"
      height="806"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <!-- Conteúdo fica acima da arte -->
  <div class="cosmic-scene__content">
    <Hero />
    <ServicesSection />
  </div>

</div>

<style>
  /* Estrutura da cena */
  .cosmic-scene {
    position: relative;
    isolation: isolate;
  }

  .cosmic-scene__content {
    position: relative;
    z-index: 2;
  }

  /* Atmosfera compartilhada */
  .cosmic-scene__ambient {
    position: absolute;
    z-index: 0;
    pointer-events: none;

    top: 3rem;
    right: -18vw;

    width: 90vw;
    height: 90%;

    background:
      radial-gradient(
        ellipse at 65% 25%,
        rgba(133, 56, 217, 0.22),
        transparent 58%
      ),
      radial-gradient(
        ellipse at 70% 72%,
        rgba(91, 54, 166, 0.13),
        transparent 68%
      );

    filter: blur(36px);
  }

  /* Arte principal */
  .cosmic-scene__art {
    position: absolute;
    z-index: 1;
    pointer-events: none;

    width: min(118vw, 1952px);
    aspect-ratio: 1952 / 806;

    top: 3rem;
    right: calc(50% - 65vw);

    /* Suavização lateral */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.45) 16%,
      black 38%,
      black 100%
    );

    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.45) 16%,
      black 38%,
      black 100%
    );
  }

  .cosmic-scene__image {
    display: block;

    width: 100%;
    height: 100%;
    object-fit: contain;

    /* Dissolução superior e inferior */
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.75) 12%,
      black 20%,
      black 64%,
      rgba(0, 0, 0, 0.8) 77%,
      transparent 100%
    );

    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.75) 12%,
      black 20%,
      black 64%,
      rgba(0, 0, 0, 0.8) 77%,
      transparent 100%
    );
  }

  /* Adaptação inicial para mobile */
  @media (max-width: 760px) {
    .cosmic-scene__art {
      width: 170vw;
      right: -55vw;
      top: 5rem;
      opacity: 0.35;
    }

    .cosmic-scene__ambient {
      width: 120vw;
      right: -50vw;
      opacity: 0.5;
    }
  }
</style>
