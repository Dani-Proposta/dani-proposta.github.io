---
import Hero from "./Hero.astro";
import ServicesSection from "./ServicesSection.astro";
---

<div class="cosmic-scene">
  <!-- Atmosfera que continua atrás dos Serviços -->
  <div class="cosmic-scene__ambient" aria-hidden="true"></div>

  <!-- Arte compartilhada entre Hero e Serviços -->
  <div class="cosmic-scene__art" aria-hidden="true">
    <img
      class="cosmic-scene__image"
      src="/images/buraco-negro-dani.webp"
      alt=""
      width="1952"
      height="806"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="cosmic-scene__content">
    <Hero />
    <ServicesSection />
  </div>
</div>

<style>
  /* Cena: o desktop mantém a composição aprovada */
  .cosmic-scene {
    position: relative;
    isolation: isolate;
  }

  .cosmic-scene__content {
    position: relative;
    z-index: 2;
  }

  .cosmic-scene__ambient {
    position: absolute;
    z-index: 0;
    top: 3rem;
    right: -18vw;
    width: 90vw;
    height: 90%;
    pointer-events: none;

    background:
      radial-gradient(
        ellipse at 65% 25%,
        rgba(133, 56, 217, 0.22),
        transparent 58%
      ),
      radial-gradient(
        ellipse at 70% 72%,
        rgba(91, 54, 166, 0.13),
        transparent 68%
      );

    filter: blur(36px);
  }

  /* Composição panorâmica original do desktop */
  .cosmic-scene__art {
    position: absolute;
    z-index: 1;
    top: 3rem;
    right: calc(50% - 65vw);
    width: min(118vw, 1952px);
    aspect-ratio: 1952 / 806;
    pointer-events: none;

    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.45) 16%,
      black 38%,
      black 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.45) 16%,
      black 38%,
      black 100%
    );
  }

  .cosmic-scene__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;

    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.75) 12%,
      black 20%,
      black 64%,
      rgba(0, 0, 0, 0.8) 77%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.75) 12%,
      black 20%,
      black 64%,
      rgba(0, 0, 0, 0.8) 77%,
      transparent 100%
    );
  }

  /* Tablet e celular: centraliza a cena na largura da janela */
  @media (max-width: 1024px) {
    .cosmic-scene__art {
      top: 0;
      left: 50%;
      right: auto;
      transform: translateX(-50%);

      width: 100vw;
      height: clamp(620px, 85svh, 830px);
      aspect-ratio: auto;
      overflow: hidden;

      -webkit-mask-image: linear-gradient(
        to bottom,
        black 0%,
        black 62%,
        rgba(0, 0, 0, 0.68) 77%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to bottom,
        black 0%,
        black 62%,
        rgba(0, 0, 0, 0.68) 77%,
        transparent 100%
      );
    }

    .cosmic-scene__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 64% center;
      -webkit-mask-image: none;
      mask-image: none;
    }

    /* Gradiente contínuo, sem um corte vertical na imagem */
    .cosmic-scene__art::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        rgba(8, 11, 22, 0.54),
        rgba(8, 11, 22, 0.30) 55%,
        rgba(8, 11, 22, 0.04)
      );
    }

    .cosmic-scene__ambient {
      top: 1rem;
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      width: 100vw;
      height: 690px;
      filter: blur(28px);
    }
  }

  /* No celular, o título recebe prioridade sobre a imagem */
  @media (max-width: 760px) {
    .cosmic-scene__art {
      height: clamp(650px, 100svh, 830px);
    }

    .cosmic-scene__image {
      object-position: 66% 48%;
    }

    .cosmic-scene__art::after {
      background: linear-gradient(
        90deg,
        rgba(8, 11, 22, 0.76) 0%,
        rgba(8, 11, 22, 0.48) 55%,
        rgba(8, 11, 22, 0.17) 100%
      );
    }

    .cosmic-scene__ambient {
      height: 640px;
      opacity: 0.72;
    }
  }

  @media (max-width: 520px) {
    .cosmic-scene__image {
      object-position: 68% center;
    }
  }
</style>
