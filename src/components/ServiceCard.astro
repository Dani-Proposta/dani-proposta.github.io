
---
import type { Service } from "../data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a class="service-card" href={`/servicos/${service.slug}/`}>
  <h3>{service.title}</h3>
  <p>{service.summary}</p>
  <span>Explorar serviço →</span>
</a>


<style>
  .service-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;

    min-height: 200px;
    padding: var(--space-md);

    color: var(--color-text);
    text-decoration: none;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);

    background:
      linear-gradient(
        145deg,
        rgba(177, 139, 255, 0.08),
        transparent 65%
      ),
      var(--color-surface);

    box-shadow: var(--shadow-panel);

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-3px);

    border-color: var(--color-border-highlight);
    box-shadow:
      var(--shadow-panel),
      var(--shadow-glow);
  }

  .service-card h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .service-card p {
    margin: 0;
  }

  .service-card span {
    margin-top: auto;
    color: var(--color-accent);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card {
      transition: none;
    }

    .service-card:hover {
      transform: none;
    }
  }
</style>

