
---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { services } from "../data/services";
import { site } from "../config/site";
import Hero from "../components/home/Hero.astro";
import StackSection from "../components/home/StackSection.astro";
import ServicesSection from "../components/home/ServicesSection.astro";
---

<BaseLayout title="Dani | Portfólio">
  
  <Hero />  

  <ServicesSection />

  <StackSection />

<section class="contact" id="contato">
  <h2>Vamos conversar sobre seu projeto?</h2>

  <p>
    Desenvolvimento de software, automações e edição
    de vídeo para necessidades reais.
  </p>

  <a href={`mailto:${site.email}`}>
    Entrar em contato →
  </a>
</section>
</BaseLayout>

<style>
  .service-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  #servicos,
  .contact {
    padding-block: 3rem;
  }
</style>
